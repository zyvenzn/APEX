{
  "name": "apex-trading-hub",
  "version": "1.0.0",
  "private": true,
  "description": "APEX social trading simulator prototype",
  "scripts": {
    "build": "node build.js && node scripts/verify-static-build.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.js",
    "test:all": "npm run build && npm test && npm run build:api && npm run test:api && npm run migrate && npm run test:api:integration && npm run test:api:migrations && npm run test:e2e",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "node server/dist/index.js",
    "build:api": "tsc -p server/tsconfig.json",
    "migrate": "tsx server/src/db/migrate-cli.ts",
    "test:api": "tsx --test server/tests/*.test.ts",
    "test:api:integration": "tsx server/tests/integration.ts",
    "test:api:browser": "tsx server/tests/browser.e2e.ts",
    "test:api:migrations": "tsx server/tests/migrate.integration.ts",
    "test:api:identity": "tsx --test server/tests/database-identity.test.ts server/tests/config.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "playwright": "1.58.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.2.0",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "zod": "4.1.12"
  }
}
